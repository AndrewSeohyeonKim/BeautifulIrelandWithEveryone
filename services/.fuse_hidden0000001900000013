  /* 강조 카드 (active 상태) */
  .tour-card.is-active {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(201,169,110,0.35), var(--shadow-hover);
    transform: translateY(-4px);
  }

  /* 가격 계산기 — 추가 옵션 (도어투도어 등) */
  .tr-addon {
    background: var(--accent-soft);
    border: 1.5px dashed var(--accent);
    border-radius: 10px;
    padding: 14px 16px;
    margin-top: 10px;
  }
  .tr-addon .tr-addon-title {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  .tr-addon-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 6px 0;
    cursor: pointer;
  }
  .tr-addon-row input[type="checkbox"] {
    margin-top: 3px;
