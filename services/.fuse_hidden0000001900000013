  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(message).then(() => {
      alert(`📋 문의 메시지가 클립보드에 복사되었어요!\n\n카톡 채팅창에 붙여넣기(Ctrl+V / 길게 누르기) 해주세요.\n\n"${message}"`);
      window.open('https://open.kakao.com/o/suSTEFsi', '_blank');
    }).catch(() => {
      window.open('https://open.kakao.com/o/suSTEFsi', '_blank');
    });
  } else {
    window.open('https://open.kakao.com/o/suSTEFsi', '_blank');
  }
}

// 즉석 코스 합류 문의
function inquireTrip(tripId) {
  const trip = OPEN_TRIPS.find(t => t.id === tripId);
  if (!trip) return;
  const message = `안녕하세요! [${trip.dateDisplay}] ${trip.course} 동행에 합류하고 싶어 문의드립니다. 자리 가능할까요?`;
  copyAndOpenKakao(message);
}

function renderOpenTrips() {
  const grid = document.getElementById('open-trips-grid');
  if (!grid) return;

  // 오늘 이전 일정은 자동 숨김
  const today = new Date().toISOString().slice(0, 10);
  const activeTrips = OPEN_TRIPS.filter(t => t.date >= today);

  if (activeTrips.length === 0) {
    grid.innerHTML = `
      <div class="trip-empty">
        <strong>현재 등록된 모집 일정이 없어요.</strong><br><br>
        원하시는 날짜·코스를 카톡으로 알려주시면<br>일정을 함께 만들어 드립니다.<br><br>
        <a href="https://open.kakao.com/o/suSTEFsi" target="_blank" class="btn btn-kakao" style="margin-top:8px;">💬 카톡 문의</a>
      </div>`;
    return;
  }

  grid.innerHTML = activeTrips.map(trip => {
    const status = TRIP_STATUS[trip.status] || TRIP_STATUS.recruiting;
    const fillPercent = Math.min(100, (trip.booked / trip.capacity) * 100);
    const remaining = trip.capacity - trip.booked;
    const isFull = trip.status === 'full' || remaining <= 0;
    const seatsText = isFull
      ? `<span class="num">${trip.booked}</span>/${trip.capacity}명 · <span class="trip-seats-full">마감</span>`
      : `<span class="num">${trip.booked}</span>/${trip.capacity}명 · ${remaining}석 남음`;
    const ctaHtml = isFull
      ? `<button class="trip-cta is-full" disabled>🚫 마감되었습니다 (모집 완료)</button>`
      : `<button class="trip-cta" onclick="inquireTrip('${trip.id}')">💬 합류 문의 (카톡)</button>`;
    // 가격 표시: 단일 또는 범위
    const priceDisplay = (trip.priceMin && trip.priceMax)
      ? `€${trip.priceMin}~€${trip.priceMax}`
      : `€${trip.pricePerPerson || trip.priceMin || trip.priceMax}`;
    return `
      <div class="trip-card${isFull ? ' is-full' : ''}">
        <span class="trip-status ${status.cls}">${status.label}</span>
        <div class="trip-head-row">
          <span class="trip-date">📅 ${trip.dateDisplay}</span>
          <span class="trip-name">${trip.course}</span>
        </div>
        <div class="trip-subtitle">${trip.courseEn}</div>
        <p class="trip-desc">${trip.description}</p>

        <div class="trip-progress">
          <div class="trip-progress-label">
            <span>모집 현황</span>
            <span class="seats">${seatsText}</span>
          </div>
          <div class="trip-progress-bar">
            <div class="trip-progress-fill" style="width:${fillPercent}%"></div>
          </div>
        </div>

        <div class="trip-meta-line">
          📍 <strong>${trip.meetingPoint}</strong> · ⏰ ${trip.meetingTime}${trip.extraNote ? ` · ${trip.extraNote}` : ''}
        </div>

        <div class="trip-price-row">
          <span class="trip-price-label">1인 가격<span class="small">${trip.priceNote || ''}</span></span>
          <span class="trip-price-amount">${priceDisplay}</span>
        </div>

        ${ctaHtml}
      </div>
    `;
  }).join('');
}

renderOpenTrips();

