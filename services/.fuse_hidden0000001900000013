  document.getElementById('modal-desc').textContent='아일랜드 날씨는 하루에도 사계절이 지나가요. 22개 코스 중 그날 날씨가 가장 좋은 지역으로 떠나는 — 비 걱정 없는 가장 확실한 방법입니다.';
  document.getElementById('modal-places-section').innerHTML=`<h5>🪄 진행 방법</h5><div class="route-stop-list">
    <div class="route-stop"><span class="rs-num">1</span><div class="rs-body"><div class="rs-name">📅 날짜·인원만 예약</div><div class="rs-desc">코스는 비워두고 출발 날짜와 인원만 먼저 확정해요.</div></div></div>
    <div class="route-stop"><span class="rs-num">2</span><div class="rs-body"><div class="rs-name">🌤️ 출발 1일 전 — 코스 확정</div><div class="rs-desc">Andrew가 지역별 예보를 비교해 가장 좋은 코스 2~3개를 제안 → 카톡으로 함께 확정해요.</div></div></div>
    <div class="route-stop"><span class="rs-num">3</span><div class="rs-body"><div class="rs-name">🚗 가장 맑은 곳으로 출발</div><div class="rs-desc">맑음 → 해안·절벽 코스 / 흐림·비 → 산·유적·실내 명소 코스로 그날의 베스트를 잡아요.</div></div></div>
  </div><div class="course-fee free">💰 가격은 확정된 코스의 정가가 그대로 적용돼요 (추가 비용 없음)</div>`;
  document.getElementById('modal-price-head').style.display='none';
  const pd=document.getElementById('modal-prices'); pd.style.display='none'; pd.innerHTML='';
  document.getElementById('modal-variations-section').style.display='none';
  document.getElementById('modal-note').style.display='none';
  const cta=document.getElementById('modal-cta'); cta.style.display='flex'; cta.textContent='💬 날씨 맞춤 여행 카톡 문의'; cta.onclick=inquireWeather;
  openModal();
}

function inquireWeather(){
  copyAndOpenKakao([
    '안녕하세요! 🌤️ 일기예보 기반 즉석 루트 여행 문의드립니다.',
    '📅 희망 날짜: ',
    '👥 인원: ',
    '코스는 출발 1일 전 날씨 보고 함께 정하고 싶어요 🙏'
  ].join('\n'));
}

