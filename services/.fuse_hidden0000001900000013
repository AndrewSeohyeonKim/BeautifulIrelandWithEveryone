    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .place-thumb img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .place-thumb .needs-photo {
    text-align: center;
    padding: 8px;
    font-size: 10.5px;
    color: var(--muted);
    line-height: 1.4;
    flex-direction: column;
  }
  .place-thumb .needs-photo .filename {
    display: inline-block;
    margin-top: 4px;
    background: white;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 9.5px;
    color: var(--accent);
    border: 1px dashed var(--accent);
  }
  .place-info { padding: 8px 10px 10px; }
  .place-name-ko { font-weight: 700; font-size: 12.5px; color: var(--primary); line-height: 1.3; }
  .place-desc-mini { font-size: 11px; color: var(--text); margin-top: 6px; line-height: 1.5; }
  .gallery-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 32px; height: 32px;
    background: white;
    border: 1px solid var(--border);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
