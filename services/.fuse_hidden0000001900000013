  .close-btn:hover { background: var(--red-soft); color: #c0392b; }
  .modal h3 { font-size: 22px; margin-bottom: 8px; line-height: 1.3; }
  .modal-meta { font-size: 13px; color: var(--muted); margin-bottom: 16px; }
  .modal h5 { font-size: 13px; color: var(--primary); margin: 18px 0 10px; text-transform: uppercase; letter-spacing: 1px; }
  .place-list { list-style: none; padding: 0; }
  .place-list li {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13.5px;
    line-height: 1.6;
  }
  .place-list li:last-child { border-bottom: none; }
  .place-list .pname { font-weight: 700; color: var(--primary); }
  .place-list .pdesc { color: var(--muted); font-size: 12.5px; margin-top: 3px; }

  /* 대표 장소 슬라이드 갤러리 */
  .gallery-header {
    display: flex; justify-content: space-between; align-items: baseline;
    margin: 18px 0 10px;
  }
  .gallery-header h5 {
    font-size: 13px; font-weight: 700; color: var(--primary); margin: 0;
    text-transform: uppercase; letter-spacing: 1px;
  }
  .gallery-header .gallery-note { font-size: 11px; color: var(--muted); }
  .places-gallery-wrap { position: relative; margin-bottom: 14px; }
  .places-gallery {
    display: flex; gap: 10px;
    overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 4px 2px 12px;
    scrollbar-width: thin;
    scrollbar-color: var(--accent) var(--bg);
  }
  .places-gallery::-webkit-scrollbar { height: 6px; }
  .places-gallery::-webkit-scrollbar-track { background: var(--bg); border-radius: 3px; }
  .places-gallery::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }
  .place-card-mini {
