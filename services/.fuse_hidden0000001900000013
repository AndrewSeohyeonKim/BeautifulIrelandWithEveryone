  @media (min-width: 600px) {
    .place-card-mini { flex: 0 0 180px; }
  }
  .place-card-mini:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  .place-thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, #e8eef5 0%, #d4dde8 100%);
