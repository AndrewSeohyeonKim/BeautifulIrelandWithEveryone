  .gallery-nav.prev { left: -10px; }
  .gallery-nav.next { right: -10px; }
  .gallery-nav:hover { background: var(--accent-soft); }
  @media (max-width: 480px) { .gallery-nav { display: none; } }
  .price-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 10px 0 16px; }
  .pricing-cell { background: var(--bg); border-radius: 8px; padding: 12px; text-align: center; }
  .pricing-cell .num { font-size: 18px; font-weight: 800; color: var(--accent); }
  .pricing-cell .lbl { font-size: 11px; color: var(--muted); }
  .var-card { background: var(--bg); border-radius: 10px; padding: 14px 16px; margin-bottom: 10px; font-size: 13.5px; }
  .var-card strong { color: var(--primary); }

  /* 스페셜 코스 카드 — 퍼핀·일기예보 즉석 루트 강조 */
  .tour-card.special-card {
