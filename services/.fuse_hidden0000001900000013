}

function openModal(){ document.getElementById('tour-modal').classList.add('open'); document.body.style.overflow='hidden'; }
function closeTourModal(){ document.getElementById('tour-modal').classList.remove('open'); document.body.style.overflow=''; }
document.addEventListener('keydown', e=>{ if(e.key==='Escape') closeTourModal(); });

function openRoute(id){
  const rt=ROUTES.find(r=>r.id===id); if(!rt) return;
  document.querySelectorAll('.ireland-marker').forEach(m=>m.classList.toggle('active', rt.pins.includes(m.dataset.tour)));
  document.getElementById('modal-name').textContent=rt.name;
  document.getElementById('modal-meta').textContent=`⏱️ 약 ${rt.hours}시간 일정 · 차 한 대 단독 동행`;
  document.getElementById('modal-desc').textContent=rt.desc||`${rt.region} · Andrew가 직접 운영해온 코스`;
  const feeTotal=rt.stops.reduce((a,s)=>a+(s.fee||0),0);
  const specialBar=rt.special?`<div class="course-fee" style="background:#eff6ff; border-color:#93c5fd; color:#1e3a8a;">${rt.special}</div>`:'';
  const feeBar=feeTotal>0?`<div class="course-fee">🎟️ 이 코스 유료 입장(선택) 합계 <strong>약 €${feeTotal}/인</strong> · 가고 싶은 곳만 결제 · 현지 가격 변동 가능</div>`:`<div class="course-fee free">🎟️ 이 코스는 유료 입장이 거의 없어요 (대부분 무료 정차지)</div>`;
  document.getElementById('modal-places-section').innerHTML=`<h5>📍 정차지 · 둘러볼 곳 (순서대로)</h5>`+specialBar+feeBar+`<div class="route-stop-list">`+
    rt.stops.map((s,i)=>{
      const thumb=s.i?`<div class="rs-thumb"><img src="${s.i}" alt="${s.n}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"><div class="rs-noimg" style="display:none;">📷</div></div>`:'';
      const fee=s.fee?`<span class="rs-fee">🎟️ 약 €${s.fee}${s.feenote?` <span class="rs-feenote">(${s.feenote})</span>`:''}</span>`:(s.feenote?`<span class="rs-fee free">🎟️ ${s.feenote}</span>`:'');
      return `<div class="route-stop${(s.i||s.d)?' rich':''}"><span class="rs-num">${i+1}</span>${thumb}<div class="rs-body"><div class="rs-name">${s.n}${fee}</div>${s.d?`<div class="rs-desc">${s.d}</div>`:''}</div></div>`;
    }).join('')+`</div>`;
  const head=document.getElementById('modal-price-head'); head.style.display=''; head.textContent=`💰 인원별 1인 부담 · 4인 총 €${rt.pp[4]*4}`;
  const pd=document.getElementById('modal-prices'); pd.style.display='';
  pd.innerHTML=[3,4,5].map(nn=>`<div class="pricing-cell${nn===4?' pricing-cell-main':''}"><div class="num">€${rt.pp[nn]}</div><div class="lbl">${nn}인 1인당 · 총 €${rt.pp[nn]*nn}</div></div>`).join('');
  document.getElementById('modal-variations-section').style.display='';
  document.getElementById('modal-variations').innerHTML=`<div class="var-card" style="border:1.5px dashed var(--accent); background:var(--accent-soft);"><strong>✏️ 이 코스도 자유롭게 커스텀</strong><br><span style="color:var(--muted); font-size:12.5px;">정차지 추가·생략·순서 조정, 점심 장소, 체력·관심사 반영 모두 가능. 목록에 없는 곳도 함께 갈 수 있어요.</span></div>`;
  document.getElementById('modal-note').style.display='';
  const cta=document.getElementById('modal-cta'); cta.style.display='flex'; cta.textContent='💬 이 코스 카톡 문의'; cta.onclick=inquireTour;
  const sel=document.getElementById('tr-dest'); if(sel){ sel.value=rt.id; calcTour(); }
  openModal();
}

function openPlace(pinKey){
  const list=ROUTES.filter(r=>r.pins.includes(pinKey));
  document.querySelectorAll('.ireland-marker').forEach(m=>m.classList.toggle('active', m.dataset.tour===pinKey));
  const pinName=PIN_NAMES[pinKey]||pinKey;
  // 대표 장소(사진 있는 정차지) 수집 — 해당 지역 폴더 우선
  const seen=new Set(), spots=[];
  for(const pass of [true,false]){
    list.forEach(rt=>rt.stops.forEach(s=>{
      if(!s.i||seen.has(s.i)) return;
      const inF=s.i.indexOf('/'+pinKey+'/')>=0;
      if(inF!==pass) return;
      seen.add(s.i); spots.push(s);
    }));
  }
  const top=spots.slice(0,14);
  document.getElementById('modal-name').textContent='📍 '+pinName;
  document.getElementById('modal-meta').textContent='대표 장소 '+top.length+'곳 · 경유 코스 '+list.length+'개';
  document.getElementById('modal-desc').textContent='';
  const gallery = top.length ? `<div class="gallery-header"><h5>📸 ${pinName} 대표 장소</h5><span class="gallery-note">← 좌우로 넘겨보세요 →</span></div><div class="places-gallery-wrap"><div class="places-gallery">`+
    top.map(s=>`<div class="place-card-mini"><div class="place-thumb"><img src="${s.i}" alt="${s.n}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"><div class="needs-photo" style="display:none;">📷<span class="filename">준비중</span></div></div><div class="place-info"><div class="place-name-ko">${s.n}</div>${s.d?`<div class="place-desc-mini">${s.d}</div>`:''}</div></div>`).join('')+
    `</div></div>` : '';
  const courses = `<h5 style="margin-top:18px;">🚗 이 장소를 지나는 코스 (눌러서 상세 보기)</h5>`+
    (list.length ? list.map(rt=>`<div class="place-route-card" onclick="openRoute('${rt.id}')"><div class="prc-top"><span class="prc-name">${rt.name}</span><span class="prc-price">€${rt.pp[4]}<span class="prc-per">/인</span></span></div><div class="prc-meta">⏱️ ${rt.hours}h · 4인 기준 · 총 €${rt.pp[4]*4} · 3인 €${rt.pp[3]} / 5인 €${rt.pp[5]}</div><div class="prc-stops">${rt.stops.slice(0,5).map(s=>s.n).join(' · ')}${rt.stops.length>5?' …':''}</div></div>`).join('') : `<p style="color:var(--muted); font-size:13.5px;">고정 코스는 아직 없지만 커스텀으로 다녀올 수 있어요.</p>`);
  document.getElementById('modal-places-section').innerHTML = gallery + courses;
  document.getElementById('modal-price-head').style.display='none';
  const pd=document.getElementById('modal-prices'); pd.style.display='none'; pd.innerHTML='';
  document.getElementById('modal-variations-section').style.display='';
  document.getElementById('modal-variations').innerHTML=`<div class="var-card" style="border:1.5px dashed var(--accent); background:var(--accent-soft);"><strong>✏️ ${pinName} 포함 커스텀 예약</strong><br><span style="color:var(--muted); font-size:12.5px;">위 코스를 변형하거나, ${pinName} 중심으로 원하는 코스를 새로 설계할 수 있어요. 목록에 없는 장소도 가능해요.</span><br><button class="btn btn-kakao" style="margin-top:10px;" onclick="event.stopPropagation(); inquireCustom('${pinName}')">💬 ${pinName} 커스텀 문의</button></div>`;
  document.getElementById('modal-note').style.display='none';
  document.getElementById('modal-cta').style.display='none';
  openModal();
}

function inquireTour(){
  const sel=document.getElementById('tr-dest'); const rt=ROUTES.find(r=>r.id===(sel&&sel.value));
  if(!rt){ copyAndOpenKakao('안녕하세요! 당일 로드트립 문의드립니다 🙏'); return; }
  let n=parseInt(document.getElementById('tr-people').value,10); if(isNaN(n)||n<3)n=3; if(n>5)n=5;
  const pickup=(document.getElementById('tr-d2d-pickup')||{}).checked;
  const drop=(document.getElementById('tr-d2d-drop')||{}).checked;
  const addon=(pickup?5:0)+(drop?5:0);
  const pp=r5(rt.total/n)+(rt.perFee||0)+addon; const total=pp*n;
  const lines=['안녕하세요! 당일 로드트립 문의드립니다.',`🌿 코스: ${rt.name} (⏱️ 약 ${rt.hours}시간)`,`👥 인원: ${n}명`,`💰 투어 총액 €${total} · 1인 €${pp}${rt.perFee?` (${rt.perFeeLabel||'승선료'} 포함)`:''}`];
  const o=[]; if(pickup)o.push('출발 픽업'); if(drop)o.push('귀가 드랍'); if(o.length)lines.push(`🚪 옵션: ${o.join(' + ')}`);
  lines.push('가능한 날짜 안내 부탁드립니다 🙏');
  copyAndOpenKakao(lines.join('\n'));
}

function inquireCustom(label){
  copyAndOpenKakao(`안녕하세요! ${label} 포함한 맞춤 1일 여행을 문의드립니다. 원하는 장소·일정 함께 잡고 싶어요 🙏`);
}

function openWeatherModal(){
  document.querySelectorAll('.ireland-marker').forEach(m=>m.classList.remove('active'));
  document.getElementById('modal-name').textContent='🌤️ 일기예보 기반 즉석 루트 여행';
