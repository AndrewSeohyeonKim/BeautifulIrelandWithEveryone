<style>
  /* 가격 계산기 */
  .calc-wrap { background: white; border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); overflow: hidden; max-width:760px; margin:0 auto; }
  .calc-body { padding: 28px 24px; }
  .calc-body .row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px; }
  .calc-body .row.single { grid-template-columns: 1fr; }
  @media (max-width: 600px) { .calc-body .row { grid-template-columns: 1fr; } }
  .field label { display: block; font-size: 13px; font-weight: 600; color: var(--primary); margin-bottom: 6px; }
  .field input, .field select {
    width: 100%; padding: 11px 13px;
    border: 1.5px solid var(--border); border-radius: 8px;
    font-size: 14.5px; font-family: inherit; background: white;
  }
  .field input:focus, .field select:focus { outline: none; border-color: var(--accent); }
  .field .hint { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .result-panel { margin-top: 22px; background: var(--accent-soft); border: 2px solid var(--accent); border-radius: 12px; padding: 22px; }
  .result-panel .result-label { font-size: 13px; color: var(--primary); font-weight: 600; margin-bottom: 4px; }
  .result-panel .result-price { font-size: 42px; font-weight: 900; color: var(--primary); letter-spacing: -2px; line-height: 1.1; margin-bottom: 14px; }
  .result-panel .result-sub { font-size: 13px; color: var(--text); margin-top: 6px; }
  .result-panel .breakdown { background: white; border-radius: 8px; padding: 14px; margin-top: 10px; }
  .result-panel .breakdown ul { list-style: none; font-size: 13.5px; }
  .result-panel .breakdown ul li { padding: 4px 0; display: flex; justify-content: space-between; }

  /* 모달 */
  .modal-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(26,41,66,0.7);
    z-index: 200;
    align-items: center; justify-content: center;
    padding: 20px;
  }
  .modal-overlay.open { display: flex; animation: pageFadeIn 0.25s ease; }
  .modal {
    background: white;
    border-radius: 16px;
    max-width: 680px;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    padding: 32px 28px;
    position: relative;
  }
  .close-btn {
    position: absolute;
    top: 14px; right: 14px;
    background: var(--bg); border: none;
    width: 34px; height: 34px;
    border-radius: 50%;
