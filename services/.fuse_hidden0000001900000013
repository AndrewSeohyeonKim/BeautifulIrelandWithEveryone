  }
  .compare-table thead tr { background: var(--primary); color: white; }
  .compare-table th { padding: 14px; font-weight: 700; font-size: 13.5px; text-align: center; }
  .compare-table th:first-child { text-align: left; }
  .compare-table td { padding: 12px 14px; border-bottom: 1px solid var(--border); text-align: center; }
  .compare-table td:first-child { text-align: left; font-weight: 600; color: var(--primary); }
  .compare-table .andrew-cell { background: var(--accent-soft); }
  .compare-table tr:last-child td { border-bottom: none; }
  @media (max-width: 600px) {
    .compare-table .andrew-cell { background: transparent !important; color: var(--primary); }
    .compare-table tr td:last-child::before {
      color: var(--accent) !important;
    }
  }

  /* ============= 모집 중인 일정 섹션 (컴팩트) ============= */
  .open-trips-section {
    background: linear-gradient(135deg, #fff7e6 0%, #fef3c7 100%);
    padding: 24px 0 28px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .open-trips-header {
    text-align: center;
    margin-bottom: 16px;
  }
  .open-trips-badge {
    display: inline-block;
    background: #dc2626;
    color: white;
    padding: 3px 12px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 1.2px;
    margin-bottom: 8px;
  }
  .open-trips-section h2 {
    font-size: 19px;
    margin: 0 0 4px;
    color: var(--primary);
    line-height: 1.25;
  }
  .open-trips-section .lead {
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.55;
    max-width: 580px;
    margin: 0 auto;
  }

  .trip-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
    max-width: 980px;
    margin: 0 auto;
  }
  @media (max-width: 600px) {
    .trip-card-grid { grid-template-columns: 1fr; }
    .trip-head-row { padding-right: 70px; }
    .trip-name { font-size: 14.5px; }
  }
  .trip-card {
    background: white;
    border-radius: 12px;
    padding: 16px 18px 14px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.06);
    border: 1.5px solid var(--accent);
    position: relative;
  }
  .trip-status {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.4px;
    color: white;
  }
  .trip-status.confirmed { background: #16a34a; }
  .trip-status.recruiting { background: #f59e0b; }
  .trip-status.almost-full { background: #dc2626; }
  .trip-status.new { background: #3b82f6; }
  .trip-status.full { background: #6b7280; }

  /* 마감된 일정 카드 */
  .trip-card.is-full { border-color: var(--border); background: #f9fafb; }
  .trip-card.is-full .trip-progress-fill { background: #9ca3af; }
  .trip-card.is-full .trip-progress-label .seats .num { color: #6b7280; }
  .trip-seats-full { color: #dc2626; font-weight: 800; }

  .trip-head-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 4px;
    padding-right: 80px;
    flex-wrap: wrap;
  }
  .trip-date {
    font-size: 12px;
    color: var(--accent);
    font-weight: 800;
    letter-spacing: 0.6px;
  }
  .trip-name {
    font-size: 15.5px;
    font-weight: 800;
    color: var(--primary);
    line-height: 1.3;
  }
  .trip-subtitle {
    font-size: 11.5px;
    color: var(--muted);
    font-style: italic;
    margin-bottom: 8px;
  }
  .trip-desc {
    font-size: 12.5px;
    color: var(--text);
    line-height: 1.55;
    margin-bottom: 10px;
  }

  .trip-progress {
    background: var(--bg);
    border-radius: 7px;
    padding: 8px 11px;
    margin-bottom: 10px;
  }
  .trip-progress-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 5px;
    font-size: 11.5px;
    color: var(--muted);
    font-weight: 600;
  }
  .trip-progress-label .seats .num {
    color: var(--accent);
    font-weight: 900;
    font-size: 14px;
  }
  .trip-progress-label .seats {
    color: var(--primary);
    font-weight: 700;
    font-size: 12px;
  }
  .trip-progress-bar {
    height: 6px;
    background: white;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .trip-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), #b8915d);
    border-radius: 3px;
    transition: width 0.4s ease;
  }

  .trip-meta-line {
    font-size: 11.5px;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 10px;
  }
  .trip-meta-line strong { color: var(--primary); font-weight: 700; }

  .trip-price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
    padding: 9px 12px;
    background: var(--accent-soft);
    border-radius: 8px;
  }
  .trip-price-label {
    font-size: 11px;
    color: var(--primary);
    font-weight: 700;
  }
  .trip-price-label .small { color: var(--muted); font-weight: 500; font-size: 10.5px; display: block; margin-top: 1px; }
  .trip-price-amount {
    font-size: 18px;
    font-weight: 900;
    color: var(--primary);
    letter-spacing: -0.5px;
  }

  .trip-cta {
    display: block;
    text-align: center;
    background: #fee500;
    color: #3c1e1e;
    border: none;
    padding: 9px 16px;
    border-radius: 8px;
    font-weight: 800;
    text-decoration: none;
    font-size: 13px;
    transition: all 0.2s;
    cursor: pointer;
    width: 100%;
    font-family: inherit;
  }
  .trip-cta:hover {
    background: #f5d800;
    transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(0,0,0,0.12);
  }
  .trip-cta.is-full {
    background: #e5e7eb;
    color: #6b7280;
    cursor: not-allowed;
  }
  .trip-cta.is-full:hover {
    background: #e5e7eb;
    transform: none;
    box-shadow: none;
  }

  .trip-empty {
    text-align: center;
    padding: 24px 18px;
    background: white;
    border-radius: 10px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
    max-width: 580px;
    margin: 0 auto;
    border: 1.5px dashed var(--border);
  }
  .trip-empty strong { color: var(--primary); }

  /* ===== ROUTE 카드/모달 (2026-06 재설계) ===== */
  .route-card .route-region { font-size: 11.5px; font-weight: 700; color: var(--accent); letter-spacing: 0.3px; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
  .route-tag { background: var(--primary); color: #fff; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 999px; letter-spacing: 0.5px; }
  .route-card .route-stops-mini { font-size: 12px; color: var(--muted); line-height: 1.55; margin: 8px 0 12px; }
  .route-stop-list { display: flex; flex-direction: column; gap: 4px; margin-bottom: 6px; }
  .route-stop { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; color: var(--text); line-height: 1.5; padding: 5px 0; border-bottom: 1px solid var(--border); }
  .route-stop:last-child { border-bottom: none; }
  .route-stop .rs-num { flex: 0 0 22px; height: 22px; border-radius: 50%; background: var(--accent-soft); color: var(--primary); font-size: 11.5px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .place-route-card { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 13px 15px; margin-bottom: 10px; cursor: pointer; transition: all 0.15s; }
  .place-route-card:hover { border-color: var(--accent); box-shadow: var(--shadow); transform: translateY(-2px); }
  .place-route-card .prc-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .place-route-card .prc-name { font-weight: 800; color: var(--primary); font-size: 14.5px; line-height: 1.3; }
  .place-route-card .prc-price { font-weight: 900; color: var(--accent); font-size: 16px; white-space: nowrap; }
  .place-route-card .prc-meta { font-size: 12px; color: var(--primary); margin: 5px 0 4px; font-weight: 600; }
  .place-route-card .prc-stops { font-size: 11.5px; color: var(--muted); line-height: 1.5; }
  .place-route-card .prc-per { font-size: 12px; color: var(--muted); font-weight: 600; }

  /* 4인 메인 가격 + 정차지 사진·소개 */
  .route-big { font-size: 19px; font-weight: 900; color: var(--primary); letter-spacing: -0.5px; }
  .route-subprice { font-size: 11.5px; color: var(--muted); margin-top: 7px; }
  .pricing-cell-main { border: 2px solid var(--accent); background: var(--accent-soft); }
  .route-stop .rs-thumb { flex: 0 0 64px; width: 64px; height: 64px; border-radius: 8px; overflow: hidden; background: linear-gradient(135deg,#e8eef5,#d4dde8); display: flex; align-items: center; justify-content: center; }
  .route-stop .rs-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .route-stop .rs-thumb .rs-noimg { width: 100%; height: 100%; align-items: center; justify-content: center; font-size: 20px; color: var(--muted); }
  .route-stop .rs-body { flex: 1; min-width: 0; }
  .route-stop .rs-name { font-weight: 700; color: var(--primary); font-size: 13.5px; line-height: 1.4; }
  .route-stop .rs-desc { font-size: 12px; color: var(--muted); line-height: 1.55; margin-top: 3px; }
